<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 标题栏: 可拖动 -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="恋爱键盘"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:maxWidth="140dp"
            android:background="@drawable/bg_badge"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text=""
            android:textColor="#B21F5C"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnFold"
            android:layout_width="38dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_btn"
            android:contentDescription="折叠/展开"
            android:scaleType="centerInside"
            android:src="@drawable/ic_fold" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="34dp"
            android:layout_height="30dp"
            android:layout_marginLeft="4dp"
            android:background="@drawable/bg_btn"
            android:contentDescription="关闭"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- 主体 -->
    <LinearLayout
        android:id="@+id/panelBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status"
            android:ellipsize="end"
            android:maxLines="3"
            android:padding="6dp"
            android:text="待命：复制对方消息后点「读剪贴板」"
            android:textColor="#FF666666"
            android:textSize="11sp" />

        <!-- 回复类型下拉框 -->
        <Spinner
            android:id="@+id/spType"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_reply" />

        <!-- 话术编辑框: 选中候选后可人工修改 -->
        <EditText
            android:id="@+id/etDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_edit"
            android:hint="话术编辑框(选中后可改)"
            android:inputType="textMultiLine|textShortMessage"
            android:maxLines="3"
            android:textColor="#FF3A3A3A"
            android:textColorHint="#FFB9A4"
            android:textSize="12sp" />

        <!-- 候选回复区: 固定高度(weight 在 wrap_content 父容器里会压成 0) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="6dp"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/llReplies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- 主操作 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRead"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="读剪贴板"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnGen"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="生成回复"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFill"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="填入发送"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 次操作: 第一行(读上下文 / 截图分析 / 清上下文) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCtx"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reply"
                android:gravity="center"
                android:text="读上下文"
                android:textColor="#FF8A6B8B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnShot"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reply"
                android:gravity="center"
                android:text="截图分析"
                android:textColor="#FF8A6B8B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnClearCtx"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reply"
                android:gravity="center"
                android:text="清上下文"
                android:textColor="#FF8A6B8B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 次操作: 第二行(设置 / 撤回 / 清理 + 内存) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSetting"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reply"
                android:gravity="center"
                android:text="设置"
                android:textColor="#FF8A6B8B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginRight="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reply"
                android:gravity="center"
                android:text="撤回"
                android:textColor="#FF8A6B8B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnCleanup"
                android:layout_width="0dp"
                android:layout_height="30dp"
                android:layout_marginRight="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reply"
                android:gravity="center"
                android:text="清理"
                android:textColor="#FF8A6B8B"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvMem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFB9A4"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- 底部: 尺寸提示 + 复位 + 缩放把手 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="2dp"
                android:text="拖右下角可缩放"
                android:textColor="#FFB9A4"
                android:textSize="10sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnResetSize"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_reply"
                android:gravity="center"
                android:minWidth="52dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="复位"
                android:textColor="#FF8A6B8B"
                android:textSize="11sp" />

            <View
                android:id="@+id/resizeHandle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_handle" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
